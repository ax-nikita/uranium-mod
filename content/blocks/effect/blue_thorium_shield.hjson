health: 1600
size: 3
liquidCapacity: 30
baseExplosiveness: 5
hasPower: true
canOverdrive: true

// Late-game wide shield. Tritium is a strategic booster, not a continuous sink.
phaseUseTime: 3600
phaseRadiusBoost: 32
phaseShieldBoost: 1000
radius: 160
shieldHealth: 2500

// Mindustry 159.7 treats these as regeneration multipliers/rates.
// 3.5 * 60 = 210 shield/sec base regeneration.
cooldownNormal: 3.5
cooldownLiquid: 1.3
// ~10.4 s to recover after a full shield break without coolant.
cooldownBrokenBase: 4

consumes: {
  power: 12
  items: {
    items: [
      tritium/1
    ]
    booster: true
    optional: true
  }
}
requirements: [
  aluminium/750
  uranium_brick/55
  metaglass/850
  silicon/450
  greatness_core/1
  iritrium/10
]
category: effect
